<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Modshift.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:AnalysisStepViewModel"
             x:Class="Modshift.Views.AnalysisStepView">
    <Grid RowDefinitions="Auto, *" Margin="10,0,10,0">

        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,15">
            <TextBlock Text="МАСТЕР ПЕРЕНОСА СБОРКИ (Шаг 1 из 2)" FontSize="16" FontWeight="Bold" Foreground="#4CAF50" />
            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="Анализ совместимости для миграции на версию:"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                <TextBlock Text="{Binding TargetInfo}" FontWeight="Bold"
                           Foreground="{DynamicResource SystemBaseHighColor}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{DynamicResource SystemRegionBrush}">
            <DataGrid ItemsSource="{Binding CompatibilityView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Имя файла / Библиотеки" Width="2*">
                        <DataTemplate x:DataType="vm:WizardModItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="5,0,0,0">
                                <TextBlock Text="{Binding Icon}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemBaseHighColor}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Тип файла" Width="1*">
                        <DataTemplate x:DataType="vm:WizardModItemViewModel">
                            <TextBlock Text="{Binding TypeDescription}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemBaseHighColor}" />
                        </DataTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Статус и Результат миграции" Width="2*">
                        <DataTemplate x:DataType="vm:WizardModItemViewModel">
                            <TextBlock Text="{Binding StatusResult}"
                                       Foreground="{Binding StatusColorBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

            </DataGrid>
        </Border>
    </Grid>
</UserControl>