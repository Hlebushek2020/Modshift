<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Modshift.ViewModels"
        mc:Ignorable="d" 
        d:DesignWidth="800" d:DesignHeight="450"
        x:DataType="vm:SettingsViewModel"
        x:Class="Modshift.Views.SettingsWindow"
        Title="⚙️ Настройки Modshift">
    <Grid RowDefinitions="*, Auto" Margin="20" Background="{DynamicResource SystemRegionBrush}">

        <!-- ОСНОВНЫЕ НАСТРОЙКИ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">
                <TextBlock Text="ОБЩИЕ НАСТРОЙКИ" FontWeight="Bold"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />

                <!-- Выбор языка (v1 - просто визуал) -->
                <StackPanel Spacing="5" Margin="5,0,0,0">
                    <TextBlock Text="Язык интерфейса (Language):" FontSize="12"
                               Foreground="{DynamicResource SystemBaseHighColor}" />
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              HorizontalAlignment="Stretch" />
                    <TextBlock Text="* Смена языка будет полностью поддерживаться в следующей версии."
                               FontSize="11"
                               Foreground="{DynamicResource SystemBaseMediumLowColor}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Separator Background="{DynamicResource SystemControlTransientBorderBrush}" />

                <!-- Заглушка под будущие настройки (например, путь к Java) -->
                <StackPanel Spacing="5" Margin="5,0,0,0" Opacity="0.5" IsEnabled="False">
                    <TextBlock Text="Путь к исполняемому файлу Java:" FontSize="12" />
                    <TextBox Watermark="Определяется автоматически (Доступно во 2-й версии)" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
                BorderThickness="0,1,0,0" Padding="0,15,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <Button Grid.Column="1"
                        Content="✔️ ЗАКРЫТЬ"
                        Command="{Binding CloseSettingsCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="25,8" />
            </Grid>
        </Border>

    </Grid>
</Window>