<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Modshift.ViewModels"
             xmlns:views="clr-namespace:Modshift.Views"
             x:Class="Modshift.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <!-- Твинк-шаблон (View Locator). 
             Говорит Avalonia: "Если в ContentControl лежит DashboardViewModel, 
             автоматически нарисуй вместо нее DashboardView" -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <!-- ИСПРАВЛЕНО: Добавлен шаблон для второй страницы (Рабочее пространство) -->
        <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
            <views:WorkspaceView />
        </DataTemplate>

        <!-- ИСПРАВЛЕНО: Добавлены шаблоны шагов мастера миграции -->
        <DataTemplate DataType="{x:Type vm:AnalysisStepViewModel}">
            <views:AnalysisStepView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ExecutionStepViewModel}">
            <views:ExecutionStepView />
        </DataTemplate>

        <!-- Сюда в будущем добавятся шаблоны для WorkspaceViewModel и других экранов -->
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- ОБЯЗАТЕЛЬНО: Подключаем стили для таблицы, чтобы она знала, как выглядеть в светлой теме -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    </Application.Styles>

</Application>